APP_NAME=AgendaAlly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local-only safeguards require BOTH flags; production and staging must
# never set DEVELOPMENT_MODE=true.
DEVELOPMENT_MODE=true
AGENDAALLY_DEVELOPMENT_DATABASE=true

# Backend and connected browser applications (override for localhost ports
# or deployment domains as needed).
APP_URL=http://localhost:8000
API_URL=http://localhost:8000
LARAVEL_BACKEND_URL=http://localhost:8000
CUSTOMER_URL=http://localhost:3000/
CUSTOMER_STOREFRONT_URL=http://localhost:3000/
FRONT_URL=http://localhost:3000/
ADMIN_URL=http://localhost:3001/
VENDOR_ADMIN_URL=http://localhost:3001/
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/development/agendaally.sqlite
# Bootstrap this owned, isolated file with the repository development command.
# To use MySQL instead, set DB_CONNECTION=mysql, clear
# AGENDAALLY_DEVELOPMENT_DATABASE, and configure the values below.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=agendaally
# DB_USERNAME=agendaally
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
EMAIL_MODE=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Never process provider payments during local development. When testing is
# explicitly configured, Stripe test keys or PayPal sandbox credentials are
# required; a local mock never creates a successful payment.
PAYMENT_MODE=disabled
PAYPAL_MODE=sandbox

# Log-only SMS does not send a code or create a successful OTP challenge.
SMS_MODE=log
TWILIO_ACCOUNT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
TWILIO_FROM_NUMBER=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=

# Local login does not bypass Firebase identity verification: Firebase-based
# sign-in fails clearly until the developer configures a real test project.
FIREBASE_ENABLED=false
FIREBASE_AUTO_DISCOVERY=false
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Web integrations can be explicitly enabled with development-owned test keys.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=

# Base URL prepended to every uploaded file's path (logos, favicons,
# category/service/shop images, ...). Must be a host the *browser* can
# actually reach, including the port, and must match APP_URL above unless
# uploads are deliberately served from a different host. Left unset here,
# FileHelper::uploadFile() falls back to APP_URL, then to the current
# request's own host as a last resort - but don't rely on that fallback
# chain when a correct explicit value is this cheap to set.
IMG_HOST=http://localhost:8000/

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

TELEGRAM_BOT_TOKEN=
TELEGRAM_LOGGER_BOT_TOKEN=

GOOGLE_CLOUD_PROJECT=
IS_DEMO=false

PROJECT_V=2.0.0

WS_SECRET=
WS_URL=
OPEN_AI_TOKEN=
AI_API_URL=
