# Copy to .env.local, then adjust these URLs for localhost, staging or hosting.
# These are public URLs/settings, not secrets. Keep actual provider secrets on
# the backend; only browser SDK public identifiers belong here.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_DEVELOPMENT_MODE=true
NEXT_PUBLIC_BASE_URL=http://localhost:8000/api/
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3002/
NEXT_PUBLIC_ADMIN_PANEL_URL=http://localhost:3003/
NEXT_PUBLIC_DEFAULT_LANGUAGE_CODE=en
NEXT_PUBLIC_DEFAULT_TOKEN_TYPE=Bearer
NEXT_PUBLIC_CACHE_TIME=60
NEXT_PUBLIC_PROJECT_NAME=AgendaAlly
NEXT_PUBLIC_IMAGE_URL=http://localhost:8000/storage/

# Server-only upstream for the development API proxy and server-side API
# requests. Defaults to http://127.0.0.1:8000; never use NEXT_PUBLIC_.
# AGENDAALLY_DEV_API_TARGET=http://127.0.0.1:8000

# Optional services stay off until intentionally enabled and configured.
# NEXT_PUBLIC_FIREBASE_ENABLED=true requires the public identifiers below.
NEXT_PUBLIC_FIREBASE_ENABLED=false
NEXT_PUBLIC_MAPS_ENABLED=false
# NEXT_PUBLIC_API_KEY=
# NEXT_PUBLIC_AUTH_DOMAIN=
# NEXT_PUBLIC_PROJECT_ID=
# NEXT_PUBLIC_STORAGE_BUCKET=
# NEXT_PUBLIC_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_APP_ID=
# NEXT_PUBLIC_MEASUREMENT_ID=
# NEXT_PUBLIC_VAPID_KEY=

# Optional provider SDKs are not initialized unless the application explicitly
# uses them. Set public keys only in the environment that owns the provider.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=