# Copy this file to .env.local and adjust each application URL for its
# environment. Public UI and API URLs are not API/service credentials.
# Customer storefront, admin panel and Laravel API remain independent.
VITE_APP_ENV=local
VITE_DEVELOPMENT_MODE=true
# The legacy VITE_BASE_URL is kept as an API-origin-only variable for the
# existing Laravel/Vite integration; do not add an API path to this value.
VITE_BASE_URL=http://localhost:8000
# Server-only upstream for Vite's development API proxy; defaults to
# http://127.0.0.1:8000. Do not add a VITE_ prefix.
# AGENDAALLY_DEV_API_TARGET=http://127.0.0.1:8000
VITE_STOREFRONT_URL=http://localhost:3002
VITE_ADMIN_PANEL_URL=http://localhost:3003
VITE_PORT=3003
VITE_HOST=0.0.0.0
# Supply exact extra hostnames only when opening the dev server over another
# hostname (e.g. a managed Replit preview); never set Vite's allowlist to *.
VITE_ALLOWED_HOSTS=

# Local development stays on Laravel password/token authentication. The
# explicit bypass cannot be carried over to staging, production or a build.
VITE_RECAPTCHA_DISABLED=true
# Production builds require an actual site key restricted to their domains.
# VITE_RECAPTCHA_SITE_KEY=

# Optional Firebase notifications and social providers stay off until fully
# configured. Enable only with real, environment-scoped Firebase public IDs.
VITE_FIREBASE_ENABLED=false
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Maps stay off until the current environment is explicitly provisioned.
VITE_MAPS_ENABLED=false
# VITE_MAP_API_KEY=

# Original authenticated API paths are preserved as /api/v1/.
# VITE_API_VERSION_PATH=/api/v1/
