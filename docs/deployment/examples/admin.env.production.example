# DOCUMENTATION TEMPLATE ONLY: incomplete, not a production build credential.
# VITE_* settings are public and compiled into the static build.
VITE_APP_ENV=production
VITE_DEVELOPMENT_MODE=false
VITE_API_ORIGIN=https://api.example.invalid
VITE_STOREFRONT_URL=https://app.example.invalid
VITE_ADMIN_PANEL_URL=https://admin.example.invalid
VITE_RECAPTCHA_DISABLED=false
VITE_RECAPTCHA_SITE_KEY=REPLACE_WITH_APPROVED_DOMAIN_RESTRICTED_PUBLIC_SITE_KEY
VITE_FIREBASE_ENABLED=false
VITE_MAPS_ENABLED=false

# Do not also set legacy VITE_BASE_URL; VITE_API_ORIGIN must have no API path.
# Do not put CAPTCHA secret, SMTP/payment/database credentials or recovery
# authorities in VITE_* variables. Do not carry a development CAPTCHA bypass.
# Production serves build/ statically; VITE_HOST/VITE_PORT are dev-server inputs.
