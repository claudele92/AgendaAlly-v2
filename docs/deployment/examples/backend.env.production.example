# DOCUMENTATION TEMPLATE ONLY: incomplete placeholders, not launch-ready.
# Supply configuration through private deployment-owned environment/dotenv.
# No generated credentials. No arbitrary *_FILE support is implied.
APP_NAME=AgendaAlly
APP_ENV=production
APP_DEBUG=false
APP_KEY=REPLACE_WITH_STABLE_DEPLOYMENT_OWNED_APP_KEY
DEVELOPMENT_MODE=false
AGENDAALLY_DEVELOPMENT_DATABASE=false
AGENDAALLY_NORMAL_ADMIN_SMTP_TEST=false

APP_URL=https://api.example.invalid
LARAVEL_BACKEND_URL=https://api.example.invalid
CUSTOMER_STOREFRONT_URL=https://app.example.invalid
VENDOR_ADMIN_URL=https://admin.example.invalid
IMG_HOST=https://api.example.invalid/
CORS_ALLOWED_ORIGINS=https://app.example.invalid,https://admin.example.invalid

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=REPLACE_WITH_DEPLOYMENT_DATABASE_NAME
DB_USERNAME=REPLACE_WITH_LEAST_PRIVILEGE_RUNTIME_USER
DB_PASSWORD=REPLACE_WITH_PRIVATE_DEPLOYMENT_PASSWORD

# Actual consumed name is FILESYSTEM_DRIVER, not FILESYSTEM_DISK.
FILESYSTEM_DRIVER=local
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN intentionally omitted for host-only cookies.
# Set it only when the approved authentication design actually needs it.
# The existing HTTP-only and SameSite controls are not changed.

LOG_CHANNEL=single
LOG_LEVEL=warning
PAYMENT_MODE=disabled
FIREBASE_ENABLED=false
MAPS_ENABLED=false
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=REPLACE_WITH_APPROVED_PUBLIC_SITE_KEY
RECAPTCHA_SECRET_KEY=REPLACE_WITH_PRIVATE_CAPTCHA_SECRET

# These are unresolved release decisions, NOT modes to copy into a live server.
# Do not turn production into local/testing to bypass integration policy.
EMAIL_MODE=REPLACE_WITH_APPROVED_PRODUCTION_EMAIL_MODE
SMS_MODE=REPLACE_WITH_APPROVED_PRODUCTION_SMS_MODE
# Mail/SMS/provider credentials, queue/scheduler policy and any optional storage
# service must be supplied only in a separately approved deployment plan.
