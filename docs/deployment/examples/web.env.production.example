# DOCUMENTATION TEMPLATE ONLY: replace example.invalid origins before building.
# NEXT_PUBLIC_* values are public and build-time; never put server secrets here.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_DEVELOPMENT_MODE=false
NEXT_PUBLIC_BASE_URL=https://api.example.invalid/api/
NEXT_PUBLIC_WEBSITE_URL=https://app.example.invalid/
NEXT_PUBLIC_ADMIN_PANEL_URL=https://admin.example.invalid/
NEXT_PUBLIC_IMAGE_URL=https://api.example.invalid/storage/
NEXT_PUBLIC_PROJECT_NAME=AgendaAlly
NEXT_PUBLIC_DEFAULT_LANGUAGE_CODE=en
NEXT_PUBLIC_DEFAULT_TOKEN_TYPE=Bearer
NEXT_PUBLIC_CACHE_TIME=60
NEXT_PUBLIC_FIREBASE_ENABLED=false
NEXT_PUBLIC_MAPS_ENABLED=false

# Private server bind settings used by the native Next production launcher.
HOST=127.0.0.1
PORT=3002
# Do not set AGENDAALLY_DEV_API_TARGET or carry local-development dotenv values.
# Optional provider browser identifiers require separate approval/configuration.
